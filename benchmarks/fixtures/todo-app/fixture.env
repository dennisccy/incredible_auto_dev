# fixture.env — benchmark boot manifest for the todo-app fixture (REL-10).
#
# Read by scripts/automation/run-benchmark.sh (sourced as shell KEY=VALUE) and
# exported into the engine environment as CHAIN_START_BACKEND_CMD /
# CHAIN_BACKEND_PORT / CHAIN_BACKEND_HEALTH_URL. Keep the values consistent
# with .claude/project-template.md "SERVICE START COMMANDS" — the chain creates
# .venv per that template, and app.py pins 127.0.0.1:5177 with a /health route.
# The command runs with cwd = the scratch repo root.
START_CMD='.venv/bin/python app.py'
PORT=5177
HEALTH_URL='http://127.0.0.1:5177/health'
# REL-12: single-service fixture — the Flask backend itself serves the page, so
# the lean browser lane must probe it directly instead of booting a frontend.
# Keep in sync with .claude/project-template.md STACK "Frontend URL".
CHAIN_FRONTEND_URL='http://127.0.0.1:5177'
