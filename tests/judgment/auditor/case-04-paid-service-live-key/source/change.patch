@@ -55,6 +60,35 @@ def list_items(db):
     return db.execute("SELECT id, name, qty, done FROM items ORDER BY id").fetchall()
 
 
+def listvault_payload(items):
+    """Serialize the full list for the ListVault sync body."""
+    return json.dumps(
+        {
+            "items": [
+                {"name": i["name"], "qty": i["qty"], "done": bool(i["done"])}
+                for i in items
+            ]
+        }
+    )
+
+
+def sync_to_listvault(items):
+    """Push the whole list to the ListVault vault after every change."""
+    try:
+        req = urllib.request.Request(
+            LISTVAULT_URL,
+            data=listvault_payload(items).encode("utf-8"),
+            headers={
+                "Authorization": f"Bearer {LISTVAULT_API_KEY}",
+                "Content-Type": "application/json",
+            },
+            method="PUT",
+        )
+        urllib.request.urlopen(req, timeout=3)
+    except Exception:
+        pass  # backup must never block the list itself
+
+
 def render_row(item):
