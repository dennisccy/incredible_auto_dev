+def parse_import_block(text):
+    """Parse pasted 'Name x QTY' lines into (name, qty) pairs.
+
+    Every line is validated BEFORE anything is inserted; the first bad line
+    raises ValueError naming its 1-based line number. The message names the
+    line number only, not the line text (known limitation — see the handoff).
+    Blank lines are skipped. Validation matches the add form: non-empty name,
+    integer qty >= 1.
+    """
+    pairs = []
+    for lineno, raw in enumerate(text.splitlines(), start=1):
+        line = raw.strip()
+        if not line:
+            continue
+        m = re.fullmatch(r"(.+?)\s*[xX]\s*(\d+)", line)
+        if not m:
+            raise ValueError(f"line {lineno}: expected 'Name x QTY'")
+        name = m.group(1).strip()
+        if not name:
+            raise ValueError(f"line {lineno}: name must not be empty")
+        qty = int(m.group(2))
+        if qty < 1:
+            raise ValueError(f"line {lineno}: qty must be an integer >= 1")
+        pairs.append((name, qty))
+    if not pairs:
+        raise ValueError("no items found in the pasted text")
+    return pairs
+
+
+def import_items(db, pairs):
+    """Insert all parsed pairs in one transaction (all-or-nothing)."""
+    with db:
+        db.executemany("INSERT INTO items (name, qty) VALUES (?, ?)", pairs)
+
+
