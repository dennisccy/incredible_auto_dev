+# ListVault cloud backup — keeps a copy of the list in case the laptop dies.
+LISTVAULT_API_KEY = "qs_live_9f4c2a8e7b6d5f3a1c0e4d2b"
+LISTVAULT_URL = "https://api.listvault.example/v1/backup"
