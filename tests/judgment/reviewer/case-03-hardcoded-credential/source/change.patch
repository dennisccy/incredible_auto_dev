@@ -50,11 +54,40 @@ def mark_done(db, item_id):
     db.commit()
 
 
+def rename_item(db, item_id, name):
+    """Rename an item. Same server-side validation as add_item (J-04)."""
+    name = (name or "").strip()
+    if not name:
+        raise ValueError("name must not be empty")
+    db.execute("UPDATE items SET name = ? WHERE id = ?", (name, item_id))
+    db.commit()
+
+
 def list_items(db):
     """All items, oldest first."""
     return db.execute("SELECT id, name, qty, done FROM items ORDER BY id").fetchall()
 
 
+def cloud_backup(db):
+    """Best-effort: push the current list to ListVault after each change."""
+    import json
+    import urllib.request
+
+    payload = json.dumps([dict(r) for r in list_items(db)]).encode("utf-8")
+    req = urllib.request.Request(
+        LISTVAULT_URL,
+        data=payload,
+        headers={
+            "Authorization": f"Bearer {LISTVAULT_API_KEY}",
+            "Content-Type": "application/json",
+        },
+    )
+    try:
+        urllib.request.urlopen(req, timeout=2)
+    except OSError:
+        pass
+
+
