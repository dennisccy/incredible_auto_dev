+def clear_done(db):
+    """Delete every done item (J-04). Returns the number of rows removed."""
+    cur = db.execute("DELETE FROM items WHERE done = 1")
+    db.commit()
+    print(f"[debug] clear_done removed {cur.rowcount} rows")
+    return cur.rowcount
+
